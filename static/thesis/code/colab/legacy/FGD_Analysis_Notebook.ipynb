    "# ============================================================\n",
    "# CELL 17: Analyze every section with Local LLM\n",
    "# ============================================================\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM\n",
    "import torch\n",
    "\n",
    "ANALYSIS_MODEL = \"Qwen/Qwen2.5-7B-Instruct\"\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(ANALYSIS_MODEL)\n",
    "analysis_model = AutoModelForCausalLM.from_pretrained(\n",
    "    ANALYSIS_MODEL,\n",
    "    torch_dtype=torch.float16,\n",
    "    device_map=\"auto\"\n",
    ")\n",
    "\n",
    "print(\"Analysis model loaded.\")\n",
    "\n",
    "def generate_analysis(prompt, max_new_tokens=1200):\n",
    "    messages = [\n",
    "        {\n",
    "            \"role\": \"system\",\n",
    "            \"content\": \"\"\"You are a rigorous qualitative research analyst specializing in focus group discussions and Mass Communication research.\n",
    "\n",
    "Do not invent participants, quotations, facts, themes, or answers.\n",
    "\n",
    "Every analytical claim must be grounded in the transcript.\n",
    "\n",
    "Distinguish clearly between:\n",
    "1. what participants explicitly said\n",
    "2. reasonable interpretation\n",
    "3. researcher-level thematic interpretation\n",
    "\n",
    "Preserve disagreement and minority opinions.\n",
    "Do not artificially create consensus.\"\"\"\n",
    "        },\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": prompt\n",
    "        }\n",
    "    ]\n",
    "\n",
    "    text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
    "\n",
    "    inputs = tokenizer(text, return_tensors=\"pt\").to(analysis_model.device)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        output = analysis_model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=max_new_tokens,\n",
    "            temperature=0.2,\n",
    "            do_sample=True,\n",
    "            top_p=0.9\n",
    "        )\n",
    "\n",
    "    generated = output[0, inputs[\"input_ids\"].shape[1]:]\n",
    "\n",
    "    return tokenizer.decode(generated, skip_special_tokens=True)"
   ]
  },
