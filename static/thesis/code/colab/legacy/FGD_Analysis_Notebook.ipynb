    "# ============================================================\n",
    "# CELL 4: Audio Preprocessing & Mastering\n",
    "# ============================================================\n",
    "import numpy as np\n",
    "import librosa\n",
    "import soundfile as sf\n",
    "import pyloudnorm as pyln\n",
    "from scipy import signal\n",
    "from pydub import AudioSegment\n",
    "import os\n",
    "\n",
    "WORK = \"/content/fgd_work\"\n",
    "os.makedirs(WORK, exist_ok=True)\n",
    "\n",
    "RAW_WAV = f\"{WORK}/raw.wav\"\n",
    "CLEAN_WAV = f\"{WORK}/audio.wav\"\n",
    "\n",
    "# Convert source to high-quality mono PCM WAV\n",
    "os.system(f'ffmpeg -y -i \"{AUDIO_INPUT}\" -ac 1 -ar 16000 -c:a pcm_s16le \"{RAW_WAV}\"')\n",
    "\n",
    "# Load\n",
    "y, sr = librosa.load(RAW_WAV, sr=16000, mono=True)\n",
    "\n",
    "print(\"Duration:\", round(len(y) / sr / 60, 2), \"minutes\")\n",
    "print(\"Sample rate:\", sr)\n",
    "\n",
    "# Remove DC offset\n",
    "y = y - np.mean(y)\n",
    "\n",
    "# Gentle high-pass filter (removes rumble)\n",
    "sos_hp = signal.butter(4, 70, btype=\"highpass\", fs=sr, output=\"sos\")\n",
    "y = signal.sosfilt(sos_hp, y)\n",
    "\n",
    "# Gentle low-pass filter (removes extreme HF noise)\n",
    "sos_lp = signal.butter(4, 7600, btype=\"lowpass\", fs=sr, output=\"sos\")\n",
    "y = signal.sosfilt(sos_lp, y)\n",
    "\n",
    "# Conservative peak protection\n",
    "peak = np.max(np.abs(y))\n",
    "if peak > 0.98:\n",
    "    y = y / peak * 0.98\n",
    "\n",
    "# Loudness normalization (EBU R128: -16 LUFS)\n",
    "meter = pyln.Meter(sr)\n",
    "try:\n",
    "    loudness = meter.integrated_loudness(y)\n",
    "    if np.isfinite(loudness):\n",
    "        y = pyln.normalize.loudness(y, loudness, -16.0)\n",
    "except Exception as e:\n",
    "    print(\"Loudness warning:\", e)\n",
    "\n",
    "# Final peak safety\n",
    "peak = np.max(np.abs(y))\n",
    "if peak > 0.98:\n",
    "    y = y / peak * 0.98\n",
    "\n",
    "sf.write(CLEAN_WAV, y.astype(np.float32), sr, subtype=\"PCM_16\")\n",
    "print(\"Created:\", CLEAN_WAV)"
   ]
  },
