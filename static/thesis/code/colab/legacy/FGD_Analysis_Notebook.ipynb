    "# ============================================================\n",
    "# CELL 5: Silero VAD - Intelligent Silence Detection\n",
    "# ============================================================\n",
    "import torch\n",
    "import torchaudio\n",
    "import numpy as np\n",
    "import soundfile as sf\n",
    "\n",
    "# Load Silero VAD model\n",
    "model, utils = torch.hub.load(\n",
    "    repo_or_dir='snakers4/silero-vad',\n",
    "    model='silero_vad',\n",
    "    force_reload=False\n",
    ")\n",
    "\n",
    "(get_speech_timestamps, save_audio, read_audio, VADIterator, collect_chunks) = utils\n",
    "\n",
    "wav = read_audio(CLEAN_WAV, sampling_rate=16000)\n",
    "\n",
    "speech_timestamps = get_speech_timestamps(\n",
    "    wav,\n",
    "    model,\n",
    "    sampling_rate=16000,\n",
    "    threshold=0.45,\n",
    "    min_speech_duration_ms=250,\n",
    "    min_silence_duration_ms=500,\n",
    "    speech_pad_ms=250\n",
    ")\n",
    "\n",
    "print(\"Detected speech regions:\", len(speech_timestamps))\n",
    "\n",
    "# Reconstruct speech-preserving audio\n",
    "chunks = []\n",
    "for seg in speech_timestamps:\n",
    "    chunks.append(wav[seg[\"start\"]:seg[\"end\"]])\n",
    "\n",
    "if not chunks:\n",
    "    raise RuntimeError(\"VAD found no speech. Try lowering the threshold.\")\n",
    "\n",
    "speech_audio = torch.cat(chunks)\n",
    "\n",
    "SPEECH_WAV = f\"{WORK}/audio_speech.wav\"\n",
    "torchaudio.save(SPEECH_WAV, speech_audio.unsqueeze(0), 16000)\n",
    "\n",
    "print(\"Created:\", SPEECH_WAV)\n",
    "print(\"Original:\", round(len(wav) / 16000 / 60, 2), \"min\")\n",
    "print(\"Speech:\", round(len(speech_audio) / 16000 / 60, 2), \"min\")"
   ]
  },
