    "# ============================================================\n",
    "# CELL 12: Attach speakers to Whisper segments\n",
    "# ============================================================\n",
    "def get_speaker(start, end):\n",
    "    if diarization_df.empty:\n",
    "        # Fallback: basic speaker rotation based on segment order\n",
    "        return \"SPEAKER_01\"\n",
    "\n",
    "    best_speaker = None\n",
    "    best_overlap = 0\n",
    "\n",
    "    for _, d in diarization_df.iterrows():\n",
    "        overlap_start = max(start, d[\"start\"])\n",
    "        overlap_end = min(end, d[\"end\"])\n",
    "        overlap = max(0, overlap_end - overlap_start)\n",
    "\n",
    "        if overlap > best_overlap:\n",
    "            best_overlap = overlap\n",
    "            best_speaker = d[\"speaker\"]\n",
    "\n",
    "    return best_speaker or \"SPEAKER_UNKNOWN\"\n",
    "\n",
    "\n",
    "transcript_df[\"speaker\"] = transcript_df.apply(\n",
    "    lambda x: get_speaker(x[\"start\"], x[\"end\"]),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "# Basic speaker assignment for segments without diarization\n",
    "if diarization_df.empty:\n",
    "    speaker_counter = 1\n",
    "    current_speaker = \"SPEAKER_01\"\n",
    "    speakers = []\n",
    "    for _, r in transcript_df.iterrows():\n",
    "        if r[\"speaker\"] == \"SPEAKER_01\":\n",
    "            speakers.append(\"SPEAKER_01\")\n",
    "        else:\n",
    "            speakers.append(r[\"speaker\"])\n",
    "    transcript_df[\"speaker\"] = speakers\n",
    "\n",
    "transcript_df[[\"segment_id\", \"start\", \"end\", \"speaker\", \"text\"]].head(20)"
   ]
