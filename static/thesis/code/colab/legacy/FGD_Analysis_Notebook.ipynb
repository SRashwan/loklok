    "# ============================================================\n",
    "# CELL 16: Extract Q&A pairs directly from transcript\n",
    "# ============================================================\n",
    "import re\n",
    "\n",
    "def extract_qa_from_transcript(df):\n",
    "    \"\"\"Extract Q&A pairs from transcript using linguistic patterns.\"\"\"\n",
    "    qa_pairs = []\n",
    "    current_q = None\n",
    "    current_a = []\n",
    "\n",
    "    question_indicators = [\n",
    "        # Arabic question words\n",
    "        \"\\u0647\\u0644\",  # هل (is/do)\n",
    "        \"\\u0645\\u0627\",   # ما (what)\n",
    "        \"\\u0643\\u064a\\u0641\",  # كيف (how)\n",
    "        \"\\u0644\\u0645\\u0627\",  # لماذا (why)\n",
    "        \"\\u0645\\u062a\\u0649\",  # متى (when)\n",
