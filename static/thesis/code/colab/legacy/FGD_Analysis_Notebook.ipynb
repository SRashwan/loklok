    "with open(TRANSCRIPT_FOR_ANALYSIS, \"w\", encoding=\"utf-8\") as f:\n",
    "    f.write(full_transcript)\n",
    "\n",
    "print(\"Full transcript length:\", len(full_transcript), \"characters\")\n",
