    "# ============================================================\n",
    "# CELL 15: Chunk long transcripts\n",
    "# ============================================================\n",
    "def chunk_dataframe(df, max_chars=18000):\n",
    "    chunks = []\n",
    "    current = []\n",
    "    current_chars = 0\n",
    "\n",
    "    for _, row in df.iterrows():\n",
    "        line = f\"[{row['start']/60:.2f}-{row['end']/60:.2f} min] {row['speaker']}: {row['text']}\\n\"\n",
    "        if current_chars + len(line) > max_chars:\n",
    "            chunks.append(\"\".join(current))\n",
    "            current = []\n",
    "            current_chars = 0\n",
    "        current.append(line)\n",
    "        current_chars += len(line)\n",
    "\n",
    "    if current:\n",
    "        chunks.append(\"\".join(current))\n",
    "\n",
    "    return chunks\n",
    "\n",
    "chunks = chunk_dataframe(transcript_df)\n",
    "print(\"Analysis chunks:\", len(chunks))\n",
    "for i, c in enumerate(chunks):\n",
    "    print(f\"  Chunk {i+1}: {len(c)} chars\")"
   ]
  },
